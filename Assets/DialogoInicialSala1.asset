  m_Script: {fileID: 11500000, guid: 1cb81bc254f557c44b9c04710656bee3, type: 3}
  m_Name: DialogoInicialSala1
  m_EditorClassIdentifier: 
  soUmaVez: 1
  falas:
  - nome: Agatha
    texto: "H\xE3, como vim parar aqui? cad\xEA a Milla? "
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: Agatha
    texto: "Me lembro que depois de assistir  \u201Cjogos mortais\u201D pela d\xE9cima
      vez no cineplex com a milla, voltamos para casa, dormimos e \u2026 n\xE3o lembro
      de mais nada, como raios eu vim parar aqui?\r\n"
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: Agatha
    texto: "Que lugar \xE9 esse?"
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: Agatha
    texto: Mila?
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: agatha
    texto: "Ainda n\xE3o entendi o que est\xE1 acontecendo, mas preciso dar um jeito
      de sair daqui."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
