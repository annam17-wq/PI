%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1cb81bc254f557c44b9c04710656bee3, type: 3}
  m_Name: DialogoTemCha
  m_EditorClassIdentifier: 
  soUmaVez: 1
  falas:
  - nome: "Rob\xF4"
    texto: "Ent\xE3o senhorita, eu percebi que voc\xEA ta um pouco perdida. Por que
      voc\xEA n\xE3o descansa um poucp? "
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: "Descansar? Eu n\xE3o posso descansar, eu preciso sair daqui, me encontrar
      com a milla, e..."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Mas tem alguma coisa que voc\xEA ainda consegue fazer?"
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: Eu...
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Olha, se EU fosse voc\xEA. aproveitaria para experimentar esse ch\xE1
      que eu preparei para voc\xEA."
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: "H\xE1, agora eu entendi. Voc\xEA envenenou esse ch\xE1 e quer me matar.
      N\xE3o vai funcionar."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Te matar? Eu s\xF3 quero que voc\xEA experimente minha obra de arte!
      Se eu quisesse voc\xEA morta, acha que eu ja n\xE3o o teria feito?"
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: "... Voc\xEA tem essa capacidade?"
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Para de pensar nessas coisas! Eu te garanto que esse ch\xE1 ir\xE1 te
      ajudar no seu objetivo"
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: "Rob\xF4"
    texto: "Ele talvez at\xE9 fa\xE7a voc\xEA enxergar coisas que voc\xEA n\xE3o
      enxerga agora;"
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: "Perai.. o ch\xE1 faz parte do enigma? Eu PRECISO tomar para sair daqui?"
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: agatha
    texto: Ele... vai me ajudar? Mesmo?
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: agatha
    texto: "Eu... acho que n\xE3o tenho op\xE7\xE3o."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
