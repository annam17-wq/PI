  m_Script: {fileID: 11500000, guid: 1cb81bc254f557c44b9c04710656bee3, type: 3}
  m_Name: DialogoRobo
  m_EditorClassIdentifier: 
  soUmaVez: 0
  falas:
  - nome: agatha
    texto: "Um animatronic? \xC9 agora que eu morro mesmo."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Ol\xE1 senhorita, como vai? "
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: "AAAAAAAAH, VOC\xCA FALA?"
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Mas \xE9 claro que sim! Agora me diz, o que voc\xEA gostaria que eu preparasse
      para voc\xEA?"
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: "NADA, por favor fique quietinho ai, n\xE3o me siga nem me mate, por favor."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Tudo bem! Se quiser um ch\xE1 para se acalmar, eu posso providenciar
      um. S\xF3 preciso da planta para isso."
    spriteFechado: {fileID: -2209074827421515703, guid: 6ef575e3cf81c84419653b633c6b070e, type: 3}
    spriteAberto: {fileID: 0}
  - nome: agatha
    texto: Haha...sim, claro, com certeza farei isso....
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
