  m_Script: {fileID: 11500000, guid: 1cb81bc254f557c44b9c04710656bee3, type: 3}
  m_Name: DialogoSemCha
  m_EditorClassIdentifier: 
  soUmaVez: 1
  falas:
  - nome: "Rob\xF4"
    texto: "Ent\xE3o senhorita, eu percebi que voc\xEA ta um pouco perdida. Por que
      voc\xEA n\xE3o descansa um pouco? "
    spriteFechado: {fileID: -5394850541725157563, guid: 6f62946670069af4293861a6a13ad9a4, type: 3}
    spriteAberto: {fileID: -8653980411494036482, guid: b1f076500edb7b84eb27001b4d432521, type: 3}
  - nome: Agatha
    texto: "Descansar? Eu n\xE3o posso descansar, eu preciso sair daqui, me encontrar
      com a milla, e..."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: Agatha
    texto: Eu...
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
  - nome: "Rob\xF4"
    texto: "Olha, se EU fosse voc\xEA. aproveitaria para me deixar fazer um ch\xE1
      para voc\xEA. Eu s\xF3 preciso de uma planta pra isso."
    spriteFechado: {fileID: -5394850541725157563, guid: 6f62946670069af4293861a6a13ad9a4, type: 3}
    spriteAberto: {fileID: -8653980411494036482, guid: b1f076500edb7b84eb27001b4d432521, type: 3}
  - nome: Agatha
    texto: "Realmente, \xE9 a \xFAnica coisa que eu n\xE3o fiz... tudo bem."
    spriteFechado: {fileID: -7660342593453531606, guid: dcbb32743ca182248b1e5c2d724c73ee, type: 3}
    spriteAberto: {fileID: -7683067344835611109, guid: 0dbf9b7721155b943a7f91aaf477aad6, type: 3}
